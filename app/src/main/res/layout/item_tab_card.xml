<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tabCardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/bg_top_pill"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/tvTabBadgeNumber"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:gravity="center"
        android:text="1"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#A8C7FA"
        android:background="@drawable/bg_tab_badge"
        android:layout_marginEnd="12dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTabCardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Page Title"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvTabCardUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="https://example.com"
            android:textSize="12sp"
            android:textColor="#CAC4D0"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnTabCardClose"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ic_close_m3"
        android:tint="#CAC4D0"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="Close tab" />

</LinearLayout>
