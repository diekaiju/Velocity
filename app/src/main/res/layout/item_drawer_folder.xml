<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutFolderItem"
    android:layout_width="match_parent"
    android:layout_height="40dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="?android:attr/selectableItemBackground"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:clickable="true"
    android:focusable="true">

    <View
        android:id="@+id/viewFolderIndent"
        android:layout_width="0dp"
        android:layout_height="1dp" />

    <ImageView
        android:id="@+id/ivFolderChevron"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_chevron_right"
        android:tint="#938F99"
        android:layout_marginEnd="6dp" />

    <TextView
        android:id="@+id/tvFolderName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="#E6E1E5"
        android:textSize="14.5sp"
        android:singleLine="true"
        android:ellipsize="end"
        tools:text="volume 1 2026" />

    <ImageButton
        android:id="@+id/btnFolderMore"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_more_vert"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:tint="#8E8E93"
        android:contentDescription="Folder options" />
</LinearLayout>
